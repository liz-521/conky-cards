#!/bin/bash
# conky-remember-pos — 记住卡片当前位置（conky-ai-cards）
# xwininfo 抓两卡窗口坐标 → 换算成 top_right 的 gap_x/gap_y → 写 pos-*.txt → 重启生效。
# 含两段校准：conky 的 gap_y 与窗口实际 y 之间有约 5px 内边距差（XFT 字体留白），
#   只记一次会整体漂移；故记完重启后复测一次，偏差补进文件再重启，收敛到零偏差。
# 依赖：xwininfo（x11-utils 包）、notify-send。
# 注：缩放不改位置文件；若缩放后两卡重叠，Super 拖开再点一次"记住位置"即可。

CONF="$HOME/.config/conky-ai-cards"
scrw=$(xwininfo -root 2>/dev/null | awk '/Width:/{print $2; exit}')
[ -z "$scrw" ] && { notify-send -u critical '悬浮卡' '读不到屏幕宽度（xwininfo 失败），没记住'; exit 1; }

geo_of() {  # $1=窗口标题 → 输出 "w x y"
    # 行形如：0x1c00002 "conky-system-card": ...  222x115+1698+960  +1698+960
    # （几何出现两遍，行尾那份无 WxH 前缀，不锚定行尾、取第一个匹配）
    xwininfo -root -tree 2>/dev/null | grep -m1 "\"$1\"" | grep -o '[0-9]*x[0-9]*+[0-9]*+[0-9]*' | head -1 \
      | awk -F'[x+]' '{print $1, $3, $4}'
}

# 第一段：抓当前坐标写文件
declare -A W0 X0 Y0
miss=0
for card in system token; do
    read -r w x y < <(geo_of "conky-$card-card")
    [ -z "$w" ] && { miss=1; continue; }
    W0[$card]=$w; X0[$card]=$x; Y0[$card]=$y
    echo "$((scrw - x - w)) $y" > "$CONF/pos-$card.txt"
done
[ $miss -ne 0 ] && { notify-send -u critical '悬浮卡' '有卡片没在运行，位置没记全（先开卡再记）'; exit 1; }

restart() { pkill -x conky 2>/dev/null; sleep 1; bash "$CONF/start-all.sh" >/dev/null 2>&1; sleep 2; }
restart

# 第二段：复测偏差补差值（窗口y = gap_y - pad，把 pad 补进文件）
fixed=0
for card in system token; do
    read -r w x y < <(geo_of "conky-$card-card")
    [ -z "$w" ] && continue
    read -r gx gy < "$CONF/pos-$card.txt"
    dx=$(( X0[$card] - x )); dy=$(( Y0[$card] - y ))
    if [ "$dx" -ne 0 ] || [ "$dy" -ne 0 ]; then
        echo "$((gx + dx)) $((gy + dy))" > "$CONF/pos-$card.txt"
        fixed=1
    fi
done
[ $fixed -eq 1 ] && restart

notify-send -i utilities-system-monitor '悬浮卡' '已记住当前位置（重启/开机后不再漂移）'
