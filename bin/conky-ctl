#!/bin/bash
# conky-ctl — 悬浮卡控制中心（conky-ai-cards）：一个入口管全部操作
# 被：应用菜单 "悬浮卡控制"（autostart/ 里有 .desktop 模板）调用；终端敲 conky-ctl 同效。
# 依赖：zenity（Ubuntu 自带）；底层动作复用 conky-card / conky-scale / conky-alpha /
#   conky-remember-pos / conky-clickthrough。

CONF="$HOME/.config/conky-ai-cards"
BIN="$HOME/.local/bin"

CT_STATE=$(cat "$CONF/clickthrough.txt" 2>/dev/null || echo off)
CT_DESC=$([ "$CT_STATE" = "on" ] && echo "当前:开 ✓已穿透（点击可关）" || echo "当前:关（点击开启穿透）")

choice=$(zenity --list --title="悬浮卡控制" --text="要做什么？" --hide-header \
  --column="操作" --column="说明" \
  "开关" "全部开启 / 全部关闭" \
  "放大" "整体 +10%" \
  "缩小" "整体 -10%" \
  "复位" "恢复默认 1.00×" \
  "记住位置" "把当前拖放位置设为默认（重启不丢）" \
  "透明度" "实色 / 半透 / 玻璃(背景全透文字实色) 六档" \
  "只留token卡" "关掉系统卡，只留今日token卡" \
  "点击穿透" "$CT_DESC" \
  --height=430 --width=430 2>/dev/null)

# Esc / 取消 → 空值，什么都不做
[ -z "$choice" ] && exit 0

case "$choice" in
  开关) "$BIN/conky-card" ;;
  放大) "$BIN/conky-scale" +0.1 ;;
  缩小) "$BIN/conky-scale" -0.1 ;;
  复位) "$BIN/conky-scale" reset ;;
  记住位置) "$BIN/conky-remember-pos" ;;
  透明度) "$BIN/conky-alpha" ;;
  只留token卡) "$BIN/conky-card" token ;;
  点击穿透) "$BIN/conky-clickthrough" toggle ;;
esac
